<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:File_server_GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="File_server_GUI.Views.Edit_balance_Window"
        x:DataType="vm:Balance_edit_Model"
        Icon="/Assets/avalonia-logo.ico"
        Title="File_server_GUI">

      <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:Balance_edit_Model/>
    </Design.DataContext>

    <StackPanel>
		<TextBlock>New balance: </TextBlock>
         <StackPanel Orientation="Horizontal">
             <TextBox Text="{Binding Str_balance}" IsReadOnly="True"></TextBox>
             <Button Click="Reset_balance">reset</Button>
             </StackPanel>
        
        <TextBlock Text="{Binding Status}"></TextBlock>
        <StackPanel Orientation="Horizontal">
             <Button Click="Sub_100">-100</Button>
             <Button Click="Sub_10">-10</Button>
             <Button Click="Sub_1">-1</Button>
             <ComboBox SelectedIndex="1"  ItemsSource="{Binding Mag_strs}"  SelectedValue="{Binding Combo_sel}" >
			  
             
             	 
             </ComboBox>
            <Button Click="Add_1">+1</Button>
              <Button Click="Add_10">+10</Button>
              <Button Click="Add_100">+100</Button>
             </StackPanel>

         <StackPanel Orientation="Horizontal">
             <Button Click="Confirm">Apply</Button>
             <Button Click="Cancel">Cancel</Button>
              </StackPanel>
    </StackPanel>






</Window>